generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model University {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  website   String?
  city      String?
  state     String?
  country   String     @default("USA")
  notes     String?
  programs  Program[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Program {
  id           String  @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  name       String // e.g. "MS Computer Science"
  degreeType String @default("MS")
  department String?

  tuitionInfo  String? // free text for now, e.g. "$45,000/yr" or "$1,200/credit"
  fundingNotes String? // TA/RA/GSR/fellowship availability, free text
  greRequired  Boolean?
  greMin       String?
  toeflMin     Int?
  ieltsMin     Float?
  gpaMin       Float?
  visaNotes    String?

  sourceUrl      String? // where auto-populated data came from
  lastScrapedAt  DateTime?
  verifiedFields Json? // per-field review flags, e.g. { "tuitionInfo": { "verified": false, "scrapedAt": "..." } }

  deadlines    Deadline[]
  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([universityId, name])
}

model Deadline {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  label     String // "Application deadline", "Fellowship deadline", "Financial aid deadline"
  date      DateTime

  @@index([programId])
}

enum ApplicationStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  INTERVIEW
  DECISION_PENDING
  ADMITTED
  REJECTED
  DECLINED
}

enum VisaType {
  F1
  J1
  OTHER
}

model Application {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  status      ApplicationStatus @default(NOT_STARTED)
  visaType    VisaType?
  notes       String?
  submittedAt DateTime?
  decisionAt  DateTime?

  fundingOffers FundingOffer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
}

model FundingOffer {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String // "TA", "RA", "Fellowship", "GSR"
  amount        String?
  notes         String?

  @@index([applicationId])
}

model NewsSource {
  id            String   @id @default(cuid())
  name          String
  type          String // "rss" | "api"
  url           String?
  keywords      String? // search query sent to the news API, e.g. "student visa policy"
  enabled       Boolean  @default(true)
  lastFetchedAt DateTime?

  articles NewsArticle[]
}

model NewsArticle {
  id          String      @id @default(cuid())
  sourceId    String?
  source      NewsSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  title       String
  url         String      @unique
  description String?
  imageUrl    String?
  publishedAt DateTime?
  fetchedAt   DateTime    @default(now())

  @@index([sourceId])
}

// A specific page (e.g. a university's admissions/funding page) that gets
// re-fetched on demand and diffed against its last known content — the
// "Site Scanner" tile.
model WatchedPage {
  id     String @id @default(cuid())
  label  String
  url    String

  lastContentHash String?
  lastContentText String? // last extracted text snapshot, for a basic diff view
  lastCheckedAt   DateTime?
  lastChangedAt   DateTime? // set whenever a check finds the hash differs from before

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

// Cross-school prep tasks (tests, SOP, outreach, visa logistics) that don't
// belong to one specific Application — the "Prep Checklist" tile.
model Task {
  id       String @id @default(cuid())
  title    String
  category String // e.g. "Prep", "Fulbright UK", "Kennedy Scholarship", "Visa & Logistics"

  targetWindow String? // free text, e.g. "Now - Mar 2027" — most of these are ranges, not exact dates
  dueDate      DateTime? // set when a specific date is known, used for sorting/reminders
  relatedTo    String? // free text, e.g. "All target schools", "Harvard or MIT only"

  status           TaskStatus @default(NOT_STARTED)
  notes            String?
  reminderLeadTime String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
