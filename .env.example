# Postgres connection string (Neon, Railway, or local). See README for setup.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Used to sign session cookies — generate with: openssl rand -base64 32
SESSION_SECRET=""

# Your login credentials (used by the seed script to create your account)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# News Feed tile — get a free key at https://gnews.io (100 requests/day free)
GNEWS_API_KEY=""
